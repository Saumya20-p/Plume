+            producer: .apple
+        )
+        XCTAssertFalse(sm.send(.markUnderrun(event: fakeEvent)))
+        XCTAssertEqual(sm.playbackState, .playing(.kokoro))
+
+        // Underrun from stale generation after seek is rejected
+        let beforeSeekEvent = try XCTUnwrap(sm.eventIdentity(for: .kokoro))
+        let seekPos = try XCTUnwrap(DocumentCursor(segment: 0, offset: 20))
+        XCTAssertTrue(sm.send(.seek(seekPos)))
+        XCTAssertFalse(sm.send(.markUnderrun(event: beforeSeekEvent)))
+    }
+
+    func testStateMachineCancellation() throws {
+        var sm = try XCTUnwrap(PlaybackStateMachine(sourceUTF16Length: 100))
+        sm.send(.requestPlay)
+        sm.send(.acquireProducer(.kokoro))
+        sm.send(.setValidBufferedAudio(true))
+        sm.send(.confirmProducerPlaying(.kokoro))
+        XCTAssertEqual(sm.playbackState, .playing(.kokoro))
+        XCTAssertTrue(sm.hasValidBufferedAudio)
+
+        // Callback token created before cancellation
+        let cursor = try XCTUnwrap(DocumentCursor(segment: 0, offset: 10))
+        let token = try XCTUnwrap(sm.beginCallback(for: .kokoro, utteranceID: UUID(), sourceBoundary: cursor))
+
+        // Cancel
+        XCTAssertTrue(sm.send(.cancel))
+        XCTAssertEqual(sm.lifecycle, .cancelled)
+        XCTAssertEqual(sm.playbackState, .idle)
+        XCTAssertNil(sm.activeProducer)
+        XCTAssertFalse(sm.hasValidBufferedAudio)
+
+        // Second cancel is idempotent / rejected
+        XCTAssertFalse(sm.send(.cancel))
+
+        // In-flight callback from before cancel is rejected
+        XCTAssertFalse(sm.send(.didFinish(cursor, callback: token)))
+        XCTAssertFalse(sm.send(.willSpeak(cursor, callback: token)))
+
+        // Cannot request play, acquire producer, or seek after cancellation
+        sm.send(.requestPlay)
+        XCTAssertEqual(sm.playbackState, .idle)
+        XCTAssertFalse(sm.send(.acquireProducer(.apple)))
+        XCTAssertFalse(sm.send(.seek(cursor)))
+    }
+
+    func testDocumentCursorMonotonicityAndBoundaries() throws {
+        // Initialization boundary validation
+        XCTAssertNil(DocumentCursor(segment: -1, offset: 0))
+        XCTAssertNil(DocumentCursor(segment: 0, offset: -1))
+        XCTAssertNotNil(DocumentCursor(segment: 0, offset: 0))
+        XCTAssertEqual(DocumentCursor.beginning, DocumentCursor(segment: 0, offset: 0))
+
+        // Cursor ordering
+        let c1 = try XCTUnwrap(DocumentCursor(segment: 0, offset: 10))
+        let c2 = try XCTUnwrap(DocumentCursor(segment: 0, offset: 20))
+        let c3 = try XCTUnwrap(DocumentCursor(segment: 1, offset: 20))
+        XCTAssertTrue(c1 < c2)
+        XCTAssertTrue(c2 < c3)
+        XCTAssertFalse(c2 < c1)
+
+        // Pure cursor state monotonicity
+        var cursorState = PlaybackCursorState(initialCursor: c1)
+        XCTAssertEqual(cursorState.displayCursor, c1)
+        XCTAssertEqual(cursorState.committedCursor, c1)
+
+        // Forward display advance succeeds
+        XCTAssertTrue(cursorState.advanceDisplay(to: c2))
+        XCTAssertEqual(cursorState.displayCursor, c2)
+        XCTAssertEqual(cursorState.committedCursor, c1) // display does not commit
+
+        // Backward display advance is rejected
+        XCTAssertFalse(cursorState.advanceDisplay(to: c1))
+        XCTAssertEqual(cursorState.displayCursor, c2)
+
+        // Forward commit succeeds
+        XCTAssertTrue(cursorState.commit(to: c2))
+        XCTAssertEqual(cursorState.committedCursor, c2)
+
+        // Backward commit is rejected
+        XCTAssertFalse(cursorState.commit(to: c1))
+        XCTAssertEqual(cursorState.committedCursor, c2)
+
+        // Seek allows arbitrary backward movement
+        cursorState.seek(to: c1)
+        XCTAssertEqual(cursorState.displayCursor, c1)
+        XCTAssertEqual(cursorState.committedCursor, c1)
+
+        // Session integration with DocumentCursor
+        var sm = try XCTUnwrap(PlaybackStateMachine(sourceUTF16Length: 50, initialCursor: c1))
+        XCTAssertEqual(sm.documentCursor, c1)
+
+        // Out-of-bounds seek is rejected
+        let outOfBounds = try XCTUnwrap(DocumentCursor(segment: 0, offset: 51))
+        XCTAssertFalse(sm.send(.seek(outOfBounds)))
+        XCTAssertEqual(sm.documentCursor, c1)
+
+        // Valid seek succeeds
+        XCTAssertTrue(sm.send(.seek(c2)))
+        XCTAssertEqual(sm.documentCursor, c2)
+    }
+
+    func testCommitBoundaryAndAdvanceDisplay() throws {
+        var contract = try makeSession(sourceLength: 100)
+        let c10 = try cursor(segment: 0, offset: 10)
+        let c15 = try cursor(segment: 0, offset: 15)
+        let c20 = try cursor(segment: 0, offset: 20)
+
+        // Advance display cursor
+        XCTAssertTrue(contract.send(.advanceDisplay(c15)))
+        XCTAssertEqual(contract.displayCursor, c15)
+        XCTAssertEqual(contract.committedCursor, .beginning)
+
+        // Commit boundary moves committedCursor
+        XCTAssertTrue(contract.send(.commitBoundary(c20)))
+        XCTAssertEqual(contract.committedCursor, c20)
+
+        // Monotonic check: older boundary commit rejected
+        XCTAssertFalse(contract.send(.commitBoundary(c10)))
+        XCTAssertEqual(contract.committedCursor, c20)
+    }
+
+    private func makeSession(
+        sourceLength: Int = 100,
+        initialCursor: PlaybackSourceCursor = .beginning
+    ) throws -> PlaybackSessionContract {
+        try XCTUnwrap(
+            PlaybackSessionContract(
+                documentID: UUID(),
+                preferences: testPreferences(),
+                sourceUTF16Length: sourceLength,
+                initialCursor: initialCursor
+            )
+        )
+    }
+
+    private func testPreferences() -> VoicePreferences {
+        VoicePreferences(
+            primary: .kokoro(identifier: "af_heart"),
+            fallbackAppleVoiceIdentifier: "apple.fallback"
+        )
+    }
+
+    private func cursor(segment: Int, offset: Int) throws -> PlaybackSourceCursor {
+        try XCTUnwrap(PlaybackSourceCursor(segmentOrdinal: segment, globalUTF16Offset: offset))
+    }
+
+    private func descriptor(
+        _ id: String,
+        language: String,
+        quality: AppleSpeechVoiceQuality
+    ) -> AppleSpeechVoiceDescriptor {
+        AppleSpeechVoiceDescriptor(id: id, name: id, language: language, quality: quality)
+    }
+
+    private func candidate(
+        _ id: String,
+        language: String,
+        quality: AppleSpeechVoiceCandidateQuality,
+        novelty: Bool = false,
+        personal: Bool = false
+    ) -> AppleSpeechVoiceCandidate {
+        AppleSpeechVoiceCandidate(
+            identifier: id,
+            name: id,
+            language: language,
+            quality: quality,
+            isNoveltyVoice: novelty,
+            isPersonalVoice: personal
+        )
+    }
+}
diff --git a/Plume/PlumeTests/PlaybackVoiceFoundationTests.swift b/Plume/PlumeTests/PlaybackVoiceFoundationTests.swift
new file mode 100644
index 0000000..a4a014b
--- /dev/null
+++ b/Plume/PlumeTests/PlaybackVoiceFoundationTests.swift
@@ -0,0 +1,284 @@
+import XCTest
+@testable import Plume
+
+@MainActor
+final class PlaybackVoiceFoundationTests: XCTestCase {
+    func testPlaybackVoiceIDCodableRoundTrip() throws {
+        let voices: [PlaybackVoiceID] = [
+            .kokoro(identifier: "af_heart"),
+            .apple(identifier: "com.apple.voice.premium")
+        ]
+
+        let encoded = try JSONEncoder().encode(voices)
+        let decoded = try JSONDecoder().decode([PlaybackVoiceID].self, from: encoded)
+
+        XCTAssertEqual(decoded, voices)
+    }
+
+    func testCatalogKeepsOnlyEnglishEnhancedAndPremiumRegularVoices() {
+        let provider = TestAppleSpeechVoiceProvider(candidates: [
+            candidate("default", language: "en-US", quality: .default),
+            candidate("french", language: "fr-FR", quality: .premium),
+            candidate("novelty", language: "en-GB", quality: .premium, isNovelty: true),
+            candidate("personal", language: "en-US", quality: .enhanced, isPersonal: true),
+            candidate("enhanced", name: "Zoe", language: "en-AU", quality: .enhanced),
+            candidate("premium", name: "Ava", language: "en-US", quality: .premium)
+        ])
+        let changeObserver = TestAppleSpeechVoiceChangeObserver()
+
+        let catalog = AppleSpeechVoiceCatalog(provider: provider, changeObserver: changeObserver)
+
+        XCTAssertEqual(catalog.voices.map(\.id), ["premium", "enhanced"])
+        XCTAssertEqual(catalog.voices.map(\.quality), [.premium, .enhanced])
+    }
+
+    func testCatalogRefreshesWhenObserverSignalsAChange() {
+        let provider = TestAppleSpeechVoiceProvider(candidates: [
+            candidate("first", name: "First", quality: .enhanced)
+        ])
+        let changeObserver = TestAppleSpeechVoiceChangeObserver()
+        let catalog = AppleSpeechVoiceCatalog(provider: provider, changeObserver: changeObserver)
+
+        provider.candidates = [
+            candidate("second", name: "Second", quality: .premium)
+        ]
+        changeObserver.sendChange()
+
+        XCTAssertEqual(catalog.voices.map(\.id), ["second"])
+    }
+
+    func testCatalogSortsByQualityThenLocalizedNameThenIdentifier() {
+        let provider = TestAppleSpeechVoiceProvider(candidates: [
+            candidate("premium-z", name: "Zoe", language: "en-AU", quality: .premium),
+            candidate("enhanced-a", name: "Ava", language: "en-US", quality: .enhanced),
+            candidate("premium-b", name: "Ava", language: "en-GB", quality: .premium),
+            candidate("premium-a", name: "Ava", language: "en-US", quality: .premium)
+        ])
+
+        let catalog = AppleSpeechVoiceCatalog(
+            provider: provider,
+            changeObserver: TestAppleSpeechVoiceChangeObserver()
+        )
+
+        XCTAssertEqual(
+            catalog.voices.map(\.id),
+            ["premium-a", "premium-b", "premium-z", "enhanced-a"]
+        )
+    }
+
+    func testCatalogCanBeEmpty() {
+        let catalog = AppleSpeechVoiceCatalog(
+            provider: TestAppleSpeechVoiceProvider(candidates: []),
+            changeObserver: TestAppleSpeechVoiceChangeObserver()
+        )
+
+        XCTAssertTrue(catalog.voices.isEmpty)
+    }
+
+    func testCatalogCancelsObservationWhenReleased() {
+        let changeObserver = TestAppleSpeechVoiceChangeObserver()
+        weak var catalog: AppleSpeechVoiceCatalog?
+
+        autoreleasepool {
+            let instance = AppleSpeechVoiceCatalog(
+                provider: TestAppleSpeechVoiceProvider(candidates: []),
+                changeObserver: changeObserver
+            )
+            catalog = instance
+            XCTAssertFalse(changeObserver.observation.isCancelled)
+        }
+
+        XCTAssertNil(catalog)
+        XCTAssertTrue(changeObserver.observation.isCancelled)
+    }
+
+    func testAVFoundationSpeechVoiceProviderCachingAndInvalidation() {
+        let testCandidate = candidate("test-voice", language: "en-US", quality: .premium)
+        AVFoundationSpeechVoiceProvider.setCachedCandidates([testCandidate])
+        XCTAssertEqual(AVFoundationSpeechVoiceProvider.cachedCandidates?.map(\.identifier), ["test-voice"])
+
+        let provider = AVFoundationSpeechVoiceProvider()
+        let voices = provider.availableVoices()
+        XCTAssertEqual(voices.map(\.identifier), ["test-voice"])
+
+        AVFoundationSpeechVoiceProvider.invalidateCache()
+        XCTAssertNil(AVFoundationSpeechVoiceProvider.cachedCandidates)
+    }
+
+    func testAVFoundationSpeechVoiceProviderCandidateQuality() {
+        XCTAssertEqual(AVFoundationSpeechVoiceProvider.candidateQuality(for: .enhanced), .enhanced)
+        XCTAssertEqual(AVFoundationSpeechVoiceProvider.candidateQuality(for: .premium), .premium)
+        XCTAssertEqual(AVFoundationSpeechVoiceProvider.candidateQuality(for: .default), .default)
+    }
+
+    func testAVFoundationSpeechVoiceProviderPrewarmPopulatesCache() async {
+        AVFoundationSpeechVoiceProvider.invalidateCache()
+        let expectation = XCTestExpectation(description: "prewarm completion")
+        AVFoundationSpeechVoiceProvider.prewarm(force: true) {
+            expectation.fulfill()
+        }
+        await fulfillment(of: [expectation], timeout: 5.0)
+        XCTAssertNotNil(AVFoundationSpeechVoiceProvider.cachedCandidates)
+    }
+
+    func testLegacyKokoroMigrationIsIdempotent() throws {
+        try withDefaults { defaults in
+            defaults.set("bm_george", forKey: "kokoroVoice")
+            let store = VoicePreferencesStore(defaults: defaults)
+
+            XCTAssertEqual(store.load().primary, .kokoro(identifier: "bm_george"))
+
+            store.save(VoicePreferences(
+                primary: .apple(identifier: "com.apple.voice.enhanced"),
+                fallbackAppleVoiceIdentifier: "com.apple.voice.fallback"
+            ))
+            defaults.set("af_heart", forKey: "kokoroVoice")
+
+            let reloadedStore = VoicePreferencesStore(defaults: defaults)
+            let preferences = reloadedStore.load()
+            XCTAssertEqual(preferences.primary, .apple(identifier: "com.apple.voice.enhanced"))
+            XCTAssertEqual(preferences.fallbackAppleVoiceIdentifier, "com.apple.voice.fallback")
+        }
+    }
+
+    func testMissingLegacyVoiceMigratesToDefault() throws {
+        try withDefaults { defaults in
+            let store = VoicePreferencesStore(defaults: defaults)
+            XCTAssertEqual(store.load().primary, .kokoro(identifier: "af_heart"))
+        }
+    }
+
+    func testUnknownLegacyVoiceMigratesToDefaultAndRetainsLegacyValue() throws {
+        try withDefaults { defaults in
+            defaults.set("not_a_known_voice", forKey: "kokoroVoice")
+            let store = VoicePreferencesStore(defaults: defaults)
+
+            XCTAssertEqual(store.load().primary, .kokoro(identifier: "af_heart"))
+            XCTAssertEqual(defaults.string(forKey: "kokoroVoice"), "not_a_known_voice")
+        }
+    }
+
+    func testCorruptCurrentPreferenceRepairsFromValidLegacyVoice() throws {
+        try withDefaults { defaults in
+            defaults.set(1, forKey: "voicePreferences.schemaVersion")
+            defaults.set("unsupported-kind", forKey: "voicePreferences.primary.kind")
+            defaults.set("value", forKey: "voicePreferences.primary.identifier")
+            defaults.set("bm_george", forKey: "kokoroVoice")
+
+            let store = VoicePreferencesStore(defaults: defaults)
+            XCTAssertEqual(store.load().primary, .kokoro(identifier: "bm_george"))
+        }
+    }
+
+    func testAppleIdentifiersPreserveUnicodeAndPunctuation() throws {
+        try withDefaults { defaults in
+            let identifier = "com.apple.voice/Élan: premium (en-US)"
+            let store = VoicePreferencesStore(defaults: defaults)
+            store.save(VoicePreferences(
+                primary: .apple(identifier: identifier),
+                fallbackAppleVoiceIdentifier: "fallback/声:v1"
+            ))
+
+            XCTAssertEqual(store.load().primary, .apple(identifier: identifier))
+            XCTAssertEqual(store.load().fallbackAppleVoiceIdentifier, "fallback/声:v1")
+        }
+    }
+
+    func testBlankApplePrimaryDoesNotPartiallySave() throws {
+        try withDefaults { defaults in
+            let store = VoicePreferencesStore(defaults: defaults)
+            store.save(VoicePreferences(
+                primary: .kokoro(identifier: "af_bella"),
+                fallbackAppleVoiceIdentifier: "original-fallback"
+            ))
+
+            store.save(VoicePreferences(
+                primary: .apple(identifier: " \n "),
+                fallbackAppleVoiceIdentifier: "replacement-fallback"
+            ))
+
+            let preferences = store.load()
+            XCTAssertEqual(preferences.primary, .kokoro(identifier: "af_bella"))
+            XCTAssertEqual(preferences.fallbackAppleVoiceIdentifier, "original-fallback")
+        }
+    }
+
+    func testStoreNormalizesIdentifiersAndClearsEmptyFallback() throws {
+        try withDefaults { defaults in
+            let store = VoicePreferencesStore(defaults: defaults)
+            store.save(VoicePreferences(
+                primary: .kokoro(identifier: "  af_bella  "),
+                fallbackAppleVoiceIdentifier: "   "
+            ))
+
+            let preferences = store.load()
+            XCTAssertEqual(preferences.primary, .kokoro(identifier: "af_bella"))
+            XCTAssertNil(preferences.fallbackAppleVoiceIdentifier)
+        }
+    }
+
+    private func withDefaults(_ body: (UserDefaults) throws -> Void) throws {
+        let suiteName = "PlaybackVoiceFoundationTests.\(UUID().uuidString)"
+        guard let defaults = UserDefaults(suiteName: suiteName) else {
+            return XCTFail("Unable to create isolated UserDefaults suite")
+        }
+        defer { defaults.removePersistentDomain(forName: suiteName) }
+        try body(defaults)
+    }
+
+    private func candidate(
+        _ identifier: String,
+        name: String? = nil,
+        language: String = "en-US",
+        quality: AppleSpeechVoiceCandidateQuality,
+        isNovelty: Bool = false,
+        isPersonal: Bool = false
+    ) -> AppleSpeechVoiceCandidate {
+        AppleSpeechVoiceCandidate(
+            identifier: identifier,
+            name: name ?? identifier,
+            language: language,
+            quality: quality,
+            isNoveltyVoice: isNovelty,
+            isPersonalVoice: isPersonal
+        )
+    }
+}
+
+@MainActor
+private final class TestAppleSpeechVoiceProvider: AppleSpeechVoiceProviding {
+    var candidates: [AppleSpeechVoiceCandidate]
+
+    init(candidates: [AppleSpeechVoiceCandidate]) {
+        self.candidates = candidates
+    }
+
+    func availableVoices() -> [AppleSpeechVoiceCandidate] {
+        candidates
+    }
+}
+
+@MainActor
+private final class TestAppleSpeechVoiceChangeObserver: AppleSpeechVoiceChangeObserving {
+    private var handler: (@MainActor () -> Void)?
+    private(set) var observation = TestAppleSpeechVoiceChangeObservation()
+
+    func observeChanges(_ handler: @escaping @MainActor () -> Void) -> any AppleSpeechVoiceChangeObservation {
+        self.handler = handler
+        return observation
+    }
+
+    func sendChange() {
+        guard !observation.isCancelled else { return }
+        handler?()
+    }
+}
+
+@MainActor
+private final class TestAppleSpeechVoiceChangeObservation: AppleSpeechVoiceChangeObservation {
+    private(set) var isCancelled = false
+
+    func cancel() {
+        isCancelled = true
+    }
+}
